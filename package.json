{
  "name": "node-red-contrib-blaulicht-sms",
  "version": "1.0.0",
  "description": "Node-RED node for receiving alarms and information from the blaulichtSMS Dashboard API",
  "keywords": [
    "node-red",
    "blaulichtsms",
    "fire-brigade",
    "emergency-services",
    "alarm",
    "dashboard"
  ],
  "license": "MIT",
  "author": {
    "name": "Christoph Rieder"
  },
  "homepage": "https://github.com/riederch/node-red-contrib-blaulicht-sms#readme",
  "bugs": {
    "url": "https://github.com/riederch/node-red-contrib-blaulicht-sms/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/riederch/node-red-contrib-blaulicht-sms.git"
  },
  "files": [
    "blaulicht-sms-dash.js",
    "blaulicht-sms-dash.html",
    "lib/",
    "examples/",
    "docs/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "README.de.md"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "node scripts/validate-package.js",
    "prepack": "npm run check && npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "node-red": {
    "version": ">=4.0.0",
    "nodes": {
      "blaulicht-sms-dashboard": "blaulicht-sms-dash.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "blaulicht-sms-dash.js"
}
