{
  "name": "node-red-contrib-blaulicht-sms",
  "version": "1.0.0-rc.1",
  "description": "Node-RED nodes for the blaulichtSMS Dashboard API and Alarm API",
  "keywords": ["node-red", "blaulichtsms", "fire-brigade", "emergency-services", "alarm", "dashboard"],
  "license": "MIT",
  "author": { "name": "Christoph Rieder" },
  "homepage": "https://github.com/riederch/node-red-contrib-blaulicht-sms#readme",
  "bugs": { "url": "https://github.com/riederch/node-red-contrib-blaulicht-sms/issues" },
  "repository": { "type": "git", "url": "https://github.com/riederch/node-red-contrib-blaulicht-sms.git" },
  "files": ["blaulicht-sms-dash.js", "blaulicht-sms-dash.html", "blaulicht-sms-alarm.js", "blaulicht-sms-alarm.html", "lib/", "examples/", "docs/", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md", "README.de.md"],
  "scripts": {
    "test": "node --test",
